generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("level")
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  name        String
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizedMatches Match[]
  participations   Participant[]
  joinRequests     JoinRequest[]
  ratingsGiven     Rating[]      @relation("RatingsGiven")
  ratingsReceived  Rating[]      @relation("RatingsReceived")

  @@map("users")
}

model Sport {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]

  @@map("sports")
}

model Match {
  id           String        @id @default(cuid())
  sportId      String
  sport        Sport         @relation(fields: [sportId], references: [id])
  level        Level
  date         DateTime
  location     String
  capacity     Int
  description  String?
  organizerId  String
  organizer    User          @relation(fields: [organizerId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  participants Participant[]
  joinRequests JoinRequest[]
  ratings      Rating[]

  @@index([date])
  @@index([sportId])
  @@map("matches")
}

model Participant {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([matchId, userId])
  @@index([userId])
  @@map("participants")
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED

  @@map("join_request_status")
}

model JoinRequest {
  id        String            @id @default(cuid())
  matchId   String
  match     Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([matchId, userId])
  @@index([userId])
  @@map("join_requests")
}

model Rating {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raterId     String
  rater       User     @relation("RatingsGiven", fields: [raterId], references: [id])
  ratedUserId String
  ratedUser   User     @relation("RatingsReceived", fields: [ratedUserId], references: [id])
  score       Int
  comment     String?
  createdAt   DateTime @default(now())

  @@unique([matchId, raterId, ratedUserId])
  @@index([ratedUserId])
  @@map("ratings")
}
